<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="text-scale" content="scale" />

    <title>Unique page title - My Site</title>

    <link rel="stylesheet" href="style.css" />
    <link rel="icon" href="public/img/favicon.ico" />

    <meta name="description" content="Page description" />
  </head>

  <body>
    <main class="chatbot">
        <% if (error) { %>
  <p role="alert"><%= error %></p>
<% } %>
      <div class="overskrift">
        <h1>Chatbot</h1>
        <h2>Velkommen til chatboten!</h2>
      </div>
      <div class="svar">
        <% for (const message of messages) { %>

            <% if (message.type === "question") { %>
              <article class="question">
                <p><%= message.text %></p> 
              </article> <% } %>

            <% if (message.type === "answer") { %>
              <article class="answer">
                <p><%= message.text %></p>
            </article><% } %>
        <% } %>
    </div>

      <form class="spørgsmål" method="POST" action="/ask">
        <div>
          <input
            type="text"
            id="question"
            name="question"
            placeholder="Skriv dit spørgsmål her:"
          />
          <div class="char-counter">
<span id="char-count">0</span>/280
</div>
          <button type="submit"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M1.7163 6.9585L21.7163 1.0411C21.8084 1.0138 21.9039 1 22 1C22.5523 1 23 1.4477 23 2C23 2.0961 22.9862 2.1916 22.9589 2.2837L17.0415 22.2837C16.9158 22.7085 16.5256 23 16.0826 23C15.7522 23 15.443 22.8368 15.2567 22.5638L9.6495 14.3505L1.4362 8.7433C1.1632 8.557 1 8.2478 1 7.9174C1 7.4744 1.2915 7.0842 1.7163 6.9585ZM16.1845 7.8155L8.3888 13.4899L9.6495 14.3505L10.5101 15.6112L16.1845 7.8155Z"/></svg></button>
        
      </form>
    </div>
      

    </main>
    <div class="emner">
      <h2>Spørgsmål fordelt på emner</h2>
      <ul>
      <li>Navn: <%= topicStats.navn %></li>
      <li>By: <%= topicStats.by %></li>
      <li>Fritid: <%= topicStats.fritid %></li>
      </ul>
  </div>
    <form class="ryd" method="POST" action="/clear-messages">
  <button type="submit">Ryd beskeder</button>
</form>
<script src="script.js"></script> 

  </body>
</html>
